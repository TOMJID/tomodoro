{
  "name": "tomodoro",
  "description": "A new CLI generated with oclif",
  "version": "0.0.0",
  "author": "TOMJID",
  "bin": {
    "tomodoro": "./bin/run.js"
  },
  "bugs": "https://github.com/Projects/tomodoro/issues",
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@oclif/plugin-plugins": "^5",
    "ink": "^8.0.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.1",
    "node-notifier": "^11.0.0",
    "play-sound": "^1.1.6",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1",
    "@oclif/prettier-config": "^0.2.1",
    "@oclif/test": "^4",
    "@types/chai": "^4",
    "@types/mocha": "^10",
    "@types/node": "^18",
    "@types/node-notifier": "^8.0.5",
    "@types/play-sound": "^1.1.2",
    "@types/react": "^19.3.0",
    "chai": "^4",
    "eslint": "^9",
    "eslint-config-oclif": "^6",
    "eslint-config-prettier": "^10",
    "mocha": "^11",
    "oclif": "^4",
    "shx": "^0.3.3",
    "ts-node": "^10",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "homepage": "https://github.com/Projects/tomodoro",
  "keywords": [
    "oclif"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "oclif": {
    "bin": "tomodoro",
    "dirname": "tomodoro",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topicSeparator": " ",
    "topics": {
      "hello": {
        "description": "Say hello to the world and others"
      }
    }
  },
  "repository": "Projects/tomodoro",
  "scripts": {
    "build": "shx rm -rf dist && tsc -b && shx cp -r src/assets dist/assets",
    "lint": "eslint",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "pnpm run lint",
    "prepack": "oclif manifest && oclif readme",
    "version": "oclif readme && git add README.md"
  },
  "types": "dist/index.d.ts"
}
